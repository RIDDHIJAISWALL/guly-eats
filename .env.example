# ============================================
# GULY EATS — Environment Variables
# ============================================
# Copy this file to .env and fill in your values
# NEVER commit .env to version control

# ---- Server ----
NODE_ENV=development
PORT=5000

# ---- MongoDB ----
# Get free cluster at https://cloud.mongodb.com
MONGODB_URI=mongodb+srv://username:password@cluster.mongodb.net/gulyeats?retryWrites=true&w=majority

# ---- JWT Secrets ----
# Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
JWT_SECRET=your-super-secret-jwt-key-min-32-chars-here
JWT_REFRESH_SECRET=another-super-secret-refresh-key-min-32-chars
JWT_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d

# ---- Frontend URL (for CORS & email links) ----
FRONTEND_URL=http://localhost:5173

# ---- Cloudinary (Image uploads) ----
# Get free account at https://cloudinary.com
CLOUDINARY_CLOUD_NAME=your-cloud-name
CLOUDINARY_API_KEY=your-api-key
CLOUDINARY_API_SECRET=your-api-secret

# ---- Email (Nodemailer — for verification & reset) ----
# For dev, use Mailtrap: https://mailtrap.io
SMTP_HOST=smtp.mailtrap.io
SMTP_PORT=587
SMTP_USER=your-mailtrap-user
SMTP_PASS=your-mailtrap-pass
EMAIL_FROM=noreply@gulyeats.com

# ---- Client (.env in client/ folder) ----
# VITE_API_URL=http://localhost:5000/api
# VITE_APP_NAME=Guly Eats
