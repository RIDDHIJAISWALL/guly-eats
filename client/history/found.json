                           d=\"M1 4l2.5 2.5L9 1\"\n682:                           stroke=\"white\"\n683:                           strokeWidth=\"2\"\n684:                           strokeLinecap=\"round\"\n685:                           strokeLinejoin=\"round\"\n686:                         />\n687:                       </svg>\n688:                     )}\n689:                   </span>\n690: \n691:                   <span className=\"text-[11px] font-medium text-gray-600 group-hover:text-gray-900\">\n692:                     {item.label}\n693:                   </span>\n694:                 </button>\n695:               ))}\n696:             </div>\n697:           </div>\n698:         </div>\n699:       </div>\n700:     </aside>\n701:   );\n702: };\n703: \n704: /* =========================================================\n705:    MAIN PAGE\n706: ========================================================= */\n707: \n708: const ExploreNearMe = () => {\n709:   const navigate = useNavigate();\n710: \n711:   /* ---------------- STATE ---------------- */\n712: \n713:   const [selectedCity, setSelectedCity] =\n714:     useState(POPULAR_CITIES[0]);\n715: \n716:   const [location, setLocation] = useState({\n717:     lat: POPULAR_CITIES[0].lat,\n718:     lng: POPULAR_CITIES[0].lng,\n719:   });\n720: \n721:   const [searchQuery, setSearchQuery] =\n722:     useState(\"\");\n723: \n724:   const [activeCategory, setActiveCategory] =\n725:     useState(\"all\");\n726: \n727:   const [distance, setDistance] =\n728:     useState(10);\n729: \n730:   const [ratingFilter, setRatingFilter] =\n731:     useState(null);\n732: \n733:   const [typeFilters, setTypeFilters] =\n734:     useState({\n735:       openNow: true,\n736:       vegOnly: false,\n737:       topRated: false,\n738:       budgetFriendly: false,\n739:     });\n740: \n741:   const [sortBy, setSortBy] =\n742:     useState(\"relevance\");\n743: \n744:   const [viewMode, setViewMode] =\n745:     useState(\"list\");\n746: \n747:   /* =========================================================\n748:      LOCATION\n749:   ========================================================= */\n750: \n751:   const handleDetectLocation = () => {\n752:     if (!navigator.geolocation) {\n753:       alert(\n754:         \"Location is not supported by your browser.\"\n755:       );\n756:       return;\n757:     }\n758: \n759:     navigator.geolocation.getCurrentPosition(\n760:       (position) => {\n761:         const newLocation = {\n762:           lat: position.coords.latitude,\n763:           lng: position.coords.longitude,\n764:         };\n765: \n766:         setLocation(newLocation);\n767: \n768:         setSelectedCity({\n769:           name: \"Current Location\",\n770:           state: \"\",\n771:           lat: newLocation.lat,\n772:           lng: newLocation.lng,\n773:         });\n774:       },\n775:       () => {\n776:         alert(\n777:           \"Unable to access your location. Please allow location permission.\"\n778:         );\n779:       }\n780:     );\n781:   };\n782: \n783:   /* =========================================================\n784:      CITY\n785:   ========================================================= */\n786: \n787:   const handleCityChange = (event) => {\n788:     const value = event.target.value;\n789: \n790:     if (value === \"__detect__\") {\n791:       handleDetectLocation();\n792:       return;\n793:     }\n794: \n795:     const city = POPULAR_CITIES.find(\n796:       (item) => item.name === value\n797:     );\n798: \n799:     if (!city) return;\n800: \nThe above content does NOT show the entire file contents. If you need to view any lines of the file which were not shown to complete your task, call this tool again to view those lines.\n"}